{
  "name": "passkeys-demo",
  "version": "1.0.0",
  "description": "Passkeys Demo",
  "main": "server.mjs",
  "type": "module",
  "scripts": {
    "build": "webpack",
    "dev": "NODE_ENV=localhost node server.mjs",
    "start": "node server.mjs",
    "deploy": "npm run build && gcloud app deploy --project passkeys-demo app.yaml",
    "emulator": "firebase emulators:start --only firestore --project passkeys-demo --import=./.data --export-on-exit"
  },
  "dependencies": {
    "@google-cloud/connect-firestore": "^3.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "aaguid": "git+https://github.com/agektmr/passkey-authenticator-aaguids.git",
    "base64url": "^3.0.1",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-handlebars": "^9.0.6",
    "express-session": "^1.19.0",
    "express-useragent": "^2.2.3",
    "firebase-admin": "^14.5.1",
    "helmet": "^8.3.0",
    "lit": "^3.3.3",
    "marked": "^18.2.0",
    "mdui": "^2.1.5",
    "webauthn-polyfills": "^0.1.7"
  },
  "engines": {
    "node": ">=22.x"
  },
  "repository": {
    "url": "https://github.com/GoogleChromeLabs/passkeys-demo"
  },
  "license": "Apache-2.0",
  "keywords": [
    "node",
    "express",
    "webauthn",
    "fido2",
    "passkey"
  ],
  "devDependencies": {
    "@babel/core": "^8.1.2",
    "babel-loader": "^10.1.1",
    "babel-preset-env": "^1.7.0",
    "css-loader": "^7.1.5",
    "extract-loader": "^5.1.0",
    "file-loader": "^6.2.0",
    "firebase-tools": "^15.36.0",
    "sass": "^1.108.2",
    "sass-loader": "^17.1.0",
    "webpack": "^5.112.2",
    "webpack-cli": "^7.3.1"
  }
}
